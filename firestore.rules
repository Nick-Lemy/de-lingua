rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sellers are readable by any authenticated user; only the owner can write
    match /sellers/{sellerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Missions belong to a buyer
    match /missions/{missionId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid
      );
      // Sellers can read missions to find matches
      allow read: if request.auth != null;
    }

    // Matches: buyers and sellers involved can read; system writes
    match /matches/{matchId} {
      allow read, write: if request.auth != null;
    }

    // Chats: only participants can read/write
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
    }

    // Feed posts: any authenticated user can read; owner can write
    match /feedPosts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
    }

    // Feed replies: any authenticated user can read/write
    match /feedReplies/{replyId} {
      allow read, write: if request.auth != null;
    }

    // Reviews: readable by all; writable by the buyer who wrote it
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        resource == null || resource.data.buyerId == request.auth.uid
      );
    }

    // Wishlist: only the buyer can manage their own wishlist
    match /wishlist/{itemId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid
      );
    }

    // Wishlist alerts: only the buyer can read/write
    match /wishlistAlerts/{alertId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        request.resource.data.buyerId == request.auth.uid
      );
    }

    // Seller analytics: owner can read/write; readable by the seller
    match /sellerAnalytics/{sellerId} {
      allow read, write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Payment requests: participants can read/write
    match /paymentRequests/{paymentId} {
      allow read, write: if request.auth != null && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
    }
  }
}
